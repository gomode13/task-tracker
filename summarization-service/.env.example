# Copy this file to .env and fill in the values

# Kafka connection
KAFKA_HOST=localhost
KAFKA_PORT=9092

# Authorization key from GigaChat Studio (base64 of client_id:client_secret)
GIGACHAT_AUTH_KEY=

# Path to the Russian Trusted Root CA certificate (download from gosuslugi.ru/crt)
GIGACHAT_CA_CERT_FILE=

# Summarization Postgres credentials
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DB=summarization_db

# Summarization Postgres connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
