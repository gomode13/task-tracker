# Copy this file to .env and fill in the values
# Values below are meant for docker-compose. To run outside Docker, replace the
# service names with localhost and use the ports published on the host:
# Kafka 9092, Postgres 5433.

# Kafka connection
KAFKA_HOST=kafka
KAFKA_PORT=19092

# Authorization key from GigaChat Studio (base64 of client_id:client_secret)
GIGACHAT_AUTH_KEY=

# Path to the Russian Trusted Root CA certificate (bundled in the image)
GIGACHAT_CA_CERT_FILE=/app/russian_trusted_root_ca.cer

# Summarization Postgres credentials
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DB=summarization_db

# Summarization Postgres connection
POSTGRES_HOST=summarization-postgres
POSTGRES_PORT=5432
