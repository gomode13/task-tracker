# Copy this file to .env and fill in the values
# Values below are meant for docker-compose. To run outside Docker, replace the
# service names with localhost and use the ports published on the host:
# Postgres 5432, RabbitMQ 5672, Redis 6379, Kafka 9092.

# Postgres credentials
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DB=task_tracker_db

# Postgres connection
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# RabbitMQ credentials
RABBITMQ_DEFAULT_USER=your_username
RABBITMQ_DEFAULT_PASS=your_password

# RabbitMQ connection
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# Redis password
REDIS_PASSWORD=your_password

# Redis connection
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka connection
KAFKA_HOST=kafka
KAFKA_PORT=19092

# JWT
JWT_SECRET_KEY=your_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookies
COOKIE_SECURE=False

# CORS
CORS_ALLOW_ORIGINS=["http://localhost:63342"]

# SMTP
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=your_api_key
EMAIL_FROM=noreply@example.com

# Daily report
DAILY_REPORT_RESPONSE_TIMEOUT_SECONDS=7200